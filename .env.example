# Neo4j Control App — copy to .env and adjust
# Never commit .env

# Streamlit
STREAMLIT_SERVER_PORT=8517
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# Paths (relative to project root unless absolute)
NEO4J_CONTROL_DATA_DIR=data
NEO4J_CONTROL_LOGS_DIR=logs
NEO4J_CONTROL_STACKS_DIR=data/stacks

# Docker / Neo4j
NEO4J_IMAGE=neo4j:5.26.0
NEO4J_DEFAULT_PASSWORD=changeme-local-only
# Host port base for Bolt (HTTP = bolt+1). Each new instance increments by 10.
NEO4J_BOLT_PORT_BASE=7687
NEO4J_HTTP_PORT_BASE=7474

# Aura (Phase 2 — leave empty for Phase 0–1)
# AURA_CLIENT_ID=
# AURA_CLIENT_SECRET=
# AURA_API_BASE=https://api.neo4j.io/v1

# MCP (Phase 4 — placeholders only)
# MCP_COMMAND=npx
# MCP_ARGS=-y @modelcontextprotocol/server-neo4j
